[Unit]
Description=FacturiGUI Production Server
After=network.target

[Service]
Type=simple
User=facturigui
Group=facturigui
WorkingDirectory=/opt/facturigui/backend
EnvironmentFile=/opt/facturigui/.env
ExecStart=/opt/facturigui/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
